{
  "name": "shopping-lists",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "npm run assets && next build && node scripts/build-sw.mjs && node scripts/copy-standalone-assets.mjs",
    "start": "node --env-file-if-exists=.env.local scripts/start.mjs",
    "lint": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "npm run assets && next typegen && tsc --noEmit && tsc --noEmit -p src/sw",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "icons": "node scripts/build-icons.mjs",
    "predev": "npm run assets",
    "assets": "node scripts/build-icons.mjs && node scripts/build-wa-dark.mjs && node scripts/build-base-css.mjs",
    "try:summaries": "tsx --conditions=react-server scripts/try-summaries.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.14.0",
    "@better-auth/cimd": "^1.7.28",
    "@better-auth/mcp": "^1.7.28",
    "@better-auth/oauth-provider": "^1.7.28",
    "@modelcontextprotocol/server": "^2.4.0",
    "@serwist/window": "^9.6.0",
    "@web.awesome.me/webawesome-pro": "3.15.0",
    "better-auth": "^1.7.28",
    "better-sqlite3": "^13.2.0",
    "dexie": "^4.4.7",
    "dexie-react-hooks": "^4.4.0",
    "drizzle-orm": "^0.45.4",
    "jose": "^6.2.18",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "^0.0.1",
    "web-push": "^4.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.1",
    "@fortawesome/free-brands-svg-icons": "7.3.1",
    "@fortawesome/pro-regular-svg-icons": "7.3.1",
    "@modelcontextprotocol/client": "^2.4.0",
    "@playwright/test": "^1.65.1",
    "@serwist/turbopack": "^9.6.0",
    "@tailwindcss/turbopack": "4.3.5",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.19.4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "eslint": "^10",
    "eslint-config-next": "16.4.6",
    "eslint-config-prettier": "^10.1.8",
    "fake-indexeddb": "^6.2.8",
    "prettier": "^3.10.1",
    "serwist": "^9.6.0",
    "tailwindcss": "4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^6",
    "vitest": "^5.1.2"
  },
  "allowScripts": {
    "better-sqlite3@13.2.0": true,
    "esbuild": false,
    "fsevents": false,
    "@swc/core": false
  },
  "engines": {
    "node": ">=24"
  }
}
