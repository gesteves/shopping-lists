# Copy to .env.local for development. Put production values in Fly secrets.
# Do not commit values. The repository is public.

# SQLite file. Default: ./data/dev.db
DATABASE_PATH=

# Auth (#2)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Comma-separated emails that can sign in.
ALLOWED_EMAILS=

# Web Push (#15)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Claude summaries (#17)
ANTHROPIC_API_KEY=

# Litestream replication to Cloudflare R2 (#3)
LITESTREAM_ACCESS_KEY_ID=
LITESTREAM_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=
